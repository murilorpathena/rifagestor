# ------------------------------------------------------------------
# Variaveis do frontend (publicadas no bundle - use apenas a anon key)
# ------------------------------------------------------------------

# Project URL do Supabase (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"

# Chave anon / public (Settings > API > anon public).
# Comeca com "eyJ..." (JWT) ou "sb_publishable_...".
# NUNCA use a service_role / secret key aqui: ela fica exposta no navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUA_CHAVE_ANON_PUBLIC"

# URL publica da aplicacao (usada em redirects e no build)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------
# Somente para os scripts de auditoria locais (supabase/audit/*.ps1).
# NUNCA defina isso no ambiente de deploy e NUNCA use no frontend.
# ------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY="SUA_SERVICE_ROLE_KEY"
